#!/bin/sh
# Block direct pushes to main, and check every commit being pushed (its files
# and message). Enable with git config core.hooksPath .githooks.
remote="$1"
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct push to main is blocked. Open a pull request." >&2
    exit 1
  fi
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes="$remote")
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi
  for commit in $commits; do
    node bin/leafbook.mjs check --rev "$commit" || exit 1
  done
done
exit 0
