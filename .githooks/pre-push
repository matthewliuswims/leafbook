#!/bin/sh
# Block direct pushes to main. Enable with git config core.hooksPath .githooks.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct push to main is blocked. Open a pull request." >&2
    exit 1
  fi
done
node bin/leafbook.mjs check || exit 1
exit 0
