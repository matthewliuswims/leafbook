{
  "name": "leafbook",
  "version": "0.1.0",
  "description": "A local, agent-first Markdown notes site",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "leafbook": "bin/leafbook.mjs"
  },
  "files": [
    "app",
    "bin",
    "components",
    "lib",
    "scripts",
    "next.config.mjs",
    "postcss.config.mjs",
    "tsconfig.json",
    "examples/starter"
  ],
  "scripts": {
    "dev": "node bin/leafbook.mjs dev",
    "build": "node bin/leafbook.mjs build",
    "start": "node bin/leafbook.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "node bin/leafbook.mjs check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "send": "^1.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.6"
    },
    "next": {
      "postcss": "^8.5.33"
    }
  }
}
